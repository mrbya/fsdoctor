{
  "name": "fsdoctor",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:eslint": "eslint ./src",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write ./src/.",
    "format-check": "prettier --check ./src/.",
    "unused": "knip --production --dependencies",
    "index": "markdown-toc -i",
    "knip": "knip",
    "tauri": "tauri",
    "lint": "prettier --check . && eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs:api": "typedoc",
    "docs:ui": "storybook build --output-dir docs-page/dev/frontend-ui",
    "docs:show": "http-server docs-page -c-1 -g -o"
  },
  "license": "MIT",
  "dependencies": {
    "@lucide/svelte": "^1.17.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/compat": "^2.0.4",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/sveltekit": "^10.4.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^24",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.4.1",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.4.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "knip": "^6.14.2",
    "markdown-toc": "^1.2.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "storybook": "^10.4.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typedoc": "^0.28.19",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
